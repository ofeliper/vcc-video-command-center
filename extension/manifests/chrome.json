{
  "manifest_version": 3,
  "name": "VCC - Video Command Center",
  "version": "0.6.1",
  "description": "Centro de controle local para players HTML5, voltado a uso pessoal.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/gm-compat.js",
        "src/tampermonkey-vcc.user.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VCC - Video Command Center",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_popup": "src/popup.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
